# Скопируйте этот файл: cp .env.example .env
# Реальные ключи пишите только в .env — он в .gitignore и не попадает в репозиторий.
# Комментарии стоят на отдельных строках: так файл одинаково читают docker-compose и pydantic-settings.

# --- PostgreSQL (контейнер postgres создаёт пользователя и базу из этих значений) ---
POSTGRES_USER=auditor
POSTGRES_PASSWORD=auditor
POSTGRES_DB=auditor
# Строка подключения для SQLAlchemy; хост "postgres" — имя сервиса в docker-compose
DATABASE_URL=postgresql+psycopg://auditor:auditor@postgres:5432/auditor
# Redis: брокер очереди Celery и кэш ответов LLM
REDIS_URL=redis://redis:6379/0

# --- Режимы нейросети (T-073) ---
# Режим выбирается в интерфейсе для каждой проверки: mock (без нейросети), local (Ollama
# в Docker), cloud (OpenAI-совместимый API по ключу). GET /api/llm/modes показывает, какие доступны.
# Режим по умолчанию: mock | local | cloud. Пусто — берётся из старых LLM_PROVIDER/LLM_BASE_URL ниже.
LLM_DEFAULT_MODE=mock
# local: адрес Ollama внутри сети Compose и имя скачанной модели (docker-compose exec ollama ollama pull <имя>)
LLM_LOCAL_BASE_URL=http://ollama:11434/v1
LLM_LOCAL_MODEL=
# cloud: адрес, ключ и модель. Ключ — только здесь: в ответы API и логи он не попадает.
# Режим cloud доступен, только если заданы все три.
LLM_CLOUD_BASE_URL=
LLM_CLOUD_API_KEY=
LLM_CLOUD_MODEL=

# --- LLM: старые переменные (устаревшее, работает) ---
# Если LLM_DEFAULT_MODE пуст, они задают режим по умолчанию: mock → mock;
# openai_compatible + адрес Ollama (хост ollama или порт 11434) → local; иначе → cloud.
# Пустые LLM_LOCAL_* / LLM_CLOUD_* этого режима заполняются из LLM_BASE_URL / LLM_API_KEY / LLM_MODEL.
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- LLM: общие настройки всех режимов ---
# Не больше стольких вызовов LLM на один документ (защита бюджета и времени)
LLM_MAX_CALLS_PER_DOC=30
# Таймаут одного запроса к LLM, секунды (> 0). Для локальной модели на CPU — 120
LLM_TIMEOUT_S=30

# --- Локальная модель (инструкция: docs/local-llm.md) ---
# Новый способ (T-073): задайте LLM_LOCAL_MODEL выше и выберите «Локальная нейросеть» в интерфейсе.
# Старый способ ниже (устаревшее, работает): в .env замените существующие строки с этими именами
# (LLM_TIMEOUT_S добавьте, если его нет); дубликатов не создавайте. Чтобы старые строки задавали
# режим по умолчанию, оставьте LLM_DEFAULT_MODE пустым (или укажите LLM_DEFAULT_MODE=local).
# ollama — заглушка, настоящий ключ для локального сервера не требуется.
# Профили — по замеру 29.10 (docs/local-llm.md, «Какую модель выбрать»):
# GPU 10–12 ГБ (рекомендуется): LLM_MODEL=gemma4:12b-it-qat, LLM_REASONING_EFFORT=none, LLM_TIMEOUT_S=60
# GPU 8 ГБ: LLM_MODEL=qwen3.5:9b, LLM_REASONING_EFFORT=none, LLM_TIMEOUT_S=60
# CPU: LLM_MODEL=hf.co/bartowski/Qwen2.5-7B-Instruct-GGUF:Q4_K_M, LLM_TIMEOUT_S=120 (без LLM_REASONING_EFFORT)
# GPU подключается отдельным файлом docker-compose.gpu.yml (см. комментарий в нём). Ниже — значения профиля CPU.
# Модель скачивается в контейнер: docker-compose exec ollama ollama pull <LLM_MODEL>
# LLM_PROVIDER=openai_compatible
# LLM_BASE_URL=http://ollama:11434/v1
# LLM_API_KEY=ollama
# LLM_MODEL=hf.co/bartowski/Qwen2.5-7B-Instruct-GGUF:Q4_K_M
# LLM_TIMEOUT_S=120
# Модели с рассуждениями (Qwen3.5, Gemma 4): без этой строки они тратят весь лимит ответа на рассуждения,
# ответ обрезается по длине и проверка получает unknown. none — выключить рассуждения (docs/local-llm.md).
# Уходит только в режиме local; облаку (режим cloud) поле не отправляется, даже если задано.
# LLM_REASONING_EFFORT=none

# --- Прочее ---
# Сколько проверок worker выполняет параллельно. Каждый процесс держит в памяти grif-cls и Natasha.
WORKER_CONCURRENCY=2
# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=50
# Сколько дней хранить отчёты
REPORT_TTL_DAYS=7

# --- Распознавание сканов и изображений ---
# Языки распознавания: русский и английский
OCR_LANG=rus+eng
# Разрешение страниц PDF при распознавании, точек на дюйм
OCR_DPI=300
# Максимум операций OCR на документ: полная страница или область изображения считается за одну
OCR_MAX_PAGES=100
# Слова с уверенностью ниже порога отмечаются в отчёте
OCR_LOW_WORD_CONF=0.6
# Страницы со средней уверенностью ниже порога отмечаются в отчёте
OCR_LOW_PAGE_CONF=0.75
